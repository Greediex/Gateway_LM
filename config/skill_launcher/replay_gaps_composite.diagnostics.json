              "upstream_is_router"
            ]
          }
        }
      },
      "claims": [
        "gp05_double_nat_v1",
        "gp05_carrier_grade_nat_v1",
        "gp05_single_nat_public_v1"
      ],
      "limitation": "Distinguishes a private WAN address behind an upstream router (double NAT) from a carrier-grade NAT address (100.64.0.0/10). Neither shows which device or camera is unreachable, whether UPnP or port forwarding is configured, or that remote access is blocked."
    },
    "GP06": {
