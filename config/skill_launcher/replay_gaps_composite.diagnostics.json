{
  "format": "gateway-lm.composite-diagnostics/v1",
  "version": "1.0.0",
  "synthetic_only": true,
  "workflows": {
    "GP01": {
      "workflow_id": "REPLAY-GP01-COMPOSITE-V1",
      "target_scope": "gateway",
      "require_same_sample_time": true,
      "sources": {
        "upstream": {
          "function_id": "expansion.upstream_probe",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "reachable": {
                "type": "boolean"
              },
              "loss_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "reachable",
              "loss_pct"
            ],
            "if": {
              "properties": {
                "reachable": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "loss_pct": {
                  "maximum": 5
                }
              }
            },
            "else": {
              "properties": {
                "loss_pct": {
                  "const": 100
                }
              }
            }
          }
        },
        "dns": {
          "function_id": "expansion.dns_resolvers",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "resolver_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "healthy_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              }
            },
            "required": [
              "resolver_count",
              "healthy_count"
            ]
          },
          "field_maximums": {
            "healthy_count": "resolver_count"
          }
        }
      },
      "claims": [
        "gp01_dns_all_resolvers_down_v1",
        "gp01_dns_resolver_healthy_v1"
      ],
      "limitation": "Reports whether the gateway upstream is reachable by IP while none of its configured DNS resolvers pass the check. A partly failing resolver set still counts as healthy. Gateway-side evidence cannot show a single client's DNS cache, split-horizon override or browser setting, and a failing upstream probe is not a DNS finding."
    },
    "GP02": {
      "workflow_id": "REPLAY-GP02-COMPOSITE-V1",
      "target_scope": "gateway",
      "require_same_sample_time": true,
      "sources": {
        "upstream": {
          "function_id": "expansion.upstream_probe",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "reachable": {
                "type": "boolean"
              },
              "loss_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "reachable",
              "loss_pct"
            ],
            "if": {
              "properties": {
                "reachable": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "loss_pct": {
                  "maximum": 5
                }
              }
            },
            "else": {
              "properties": {
                "loss_pct": {
                  "const": 100
                }
              }
            }
          }
        },
        "mss": {
          "function_id": "expansion.wan_mss",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "proto": {
                "type": "string",
                "enum": [
                  "pppoe",
                  "dhcp",
                  "static"
                ]
              },
              "mtu_bytes": {
                "type": "integer",
                "minimum": 576,
                "maximum": 9216
              },
              "mss_clamping": {
                "type": "boolean"
              }
            },
            "required": [
              "proto",
              "mtu_bytes",
              "mss_clamping"
            ]
          }
        }
      },
      "claims": [
        "gp02_pppoe_mss_not_clamped_v1",
        "gp02_pppoe_mss_clamped_v1",
        "gp02_standard_mtu_v1"
      ],
      "limitation": "Reports a WAN MTU below 1500 on PPPoE without MSS clamping, the configuration that can silently drop large TCP packets. It does not show that ICMP fragmentation-needed is blocked, which sites fail, or measured throughput."
    },
    "GP03": {
      "workflow_id": "REPLAY-GP03-COMPOSITE-V1",
      "target_scope": "gateway",
      "require_same_sample_time": true,
      "sources": {
        "ra": {
          "function_id": "expansion.ipv6_ra",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "router_advertisements": {
                "type": "boolean"
              },
              "prefix_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            },
            "required": [
              "router_advertisements",
              "prefix_count"
            ]
          }
        },
        "v6": {
          "function_id": "expansion.ipv6_connectivity",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "global_address": {
                "type": "boolean"
              },
              "default_route": {
                "type": "boolean"
              },
              "reachable": {
                "type": "boolean"
              }
            },
            "required": [
              "global_address",
              "default_route",
              "reachable"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "global_address": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reachable": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "default_route": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reachable": {
                      "const": false
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "claims": [
        "gp03_ipv6_address_without_route_v1",
        "gp03_ipv6_route_unreachable_v1",
        "gp03_ipv6_working_v1",
        "gp03_ipv6_not_offered_v1"
      ],
      "limitation": "Separates broken IPv6 (a global address without a working route or path) from a network that offers no IPv6, which is not a fault. It does not locate the cause (RA, prefix delegation or ICMPv6 filtering) or show per-client addressing."
    },
    "GP04": {
      "workflow_id": "REPLAY-GP04-COMPOSITE-V1",
      "target_scope": "gateway",
      "require_same_sample_time": true,
      "sources": {
        "load": {
          "function_id": "expansion.system_load",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
              "cpu_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "load1": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "mem_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "clients_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              }
            },
            "required": [
              "cpu_pct",
              "load1",
              "mem_pct",
              "clients_count"
            ]
          }
        }
      },
      "claims": [
        "gp04_router_overloaded_v1",
        "gp04_router_load_normal_v1"
      ],
      "limitation": "Reports router CPU at or above 85 percent together with at least 25 online devices as overload. High CPU with few devices, or memory pressure alone, has no verdict. Thresholds are uncalibrated simulation heuristics, load1 is not normalized by core count, and the sample does not identify which device or flow causes the load."
    },
    "GP05": {
      "workflow_id": "REPLAY-GP05-COMPOSITE-V1",
      "target_scope": "gateway",
      "require_same_sample_time": true,
      "sources": {
        "nat": {
          "function_id": "expansion.nat_state",
          "scope": "gateway",
          "target": "synthetic-test-target",
          "value_schema": {
            "type": "object",
            "properties": {
