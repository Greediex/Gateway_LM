        "gp06_no_radar_in_window_v1"
      ],
      "limitation": "Reports radar detections on the 5 GHz radio with a matching channel change inside the observation window. It does not list the affected clients, the new channel, or how long the outage lasted."
    },
    "GP07": {
      "workflow_id": "REPLAY-GP07-COMPOSITE-V1",
