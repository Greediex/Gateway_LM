{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "router-context-query-v1.schema.json",
 "title": "router-contextd reader query",
 "description": "One read request to router-contextd (Router_App/router_context_src/README.md 'Reader'). Fixed operations and allowlisted parameters only: no SQL, no paths, no free filters. The caller's role/scopes are NOT part of the query: they come from a trusted context supplied by the application (issuer app_auth + D15 grant), never from model-generated arguments.",
 "type": "object",
 "required": ["op"],
 "oneOf": [
  {"properties": {"op": {"const": "read_status"}, "view": {"enum": ["system", "wan", "lan", "wifi", "device", "overview", "feeds"]},
                  "entity": {"type": "string", "maxLength": 96}, "names": {"type": "array", "items": {"type": "string", "maxLength": 48}, "maxItems": 16},
                  "alias_scope": {"type": "string", "pattern": "^a[0-9a-f]{8}$", "description": "scope of the view that issued the dN aliases used here; required with any dN"}},
   "required": ["op", "view"], "additionalProperties": false},
  {"properties": {"op": {"const": "read_history"}, "metric": {"type": "string", "maxLength": 48}, "entity": {"type": "string", "maxLength": 96},
                  "window_s": {"enum": [300, 900, 3600, 21600, 86400, 604800]}, "require_live": {"type": "boolean"},
                  "compare": {"type": "object", "properties": {"before": {"type": "object", "properties": {"since": {"type": "string"}, "until": {"type": "string"}}, "required": ["since", "until"], "additionalProperties": false}, "after": {"type": "object", "properties": {"since": {"type": "string"}, "until": {"type": "string"}}, "required": ["since", "until"], "additionalProperties": false}},
                              "required": ["before", "after"], "additionalProperties": false,
                              "description": "before/after: two ordered, non-overlapping RFC 3339 ranges of at most 86400 s each; excludes window_s"},
                  "baseline_ref": {"type": "string", "maxLength": 128, "description": "D03 baseline_marker record id: window_s before and after its time"},
                  "alias_scope": {"type": "string", "pattern": "^a[0-9a-f]{8}$", "description": "scope of the view that issued the dN aliases used here; required with any dN"}},
   "required": ["op", "metric"], "additionalProperties": false},
  {"properties": {"op": {"const": "read_changes"}, "entity": {"type": "string", "maxLength": 96}, "cursor": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]+:[0-9]+$"},
                  "since": {"type": "string"}, "until": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50},
                  "require_live": {"type": "boolean"}, "alias_scope": {"type": "string", "pattern": "^a[0-9a-f]{8}$", "description": "scope of the view that issued the dN aliases used here; required with any dN"}},
   "required": ["op"], "additionalProperties": false},
  {"properties": {"op": {"const": "read_records"}, "kind": {"type": "string", "description": "kind name (sessions_requests) or id (D06)"},
                  "subtype": {"type": "string"}, "entity": {"type": "string"}, "session": {"type": "string"}, "incident": {"type": "string"},
                  "where": {"type": "object", "maxProperties": 4, "additionalProperties": {"type": ["string", "boolean"]},
                            "description": "Equality on enum/bool/ref payload fields of the kind's schema; private fields refused"},
                  "detail": {"enum": ["concise", "detail"]}, "require_live": {"type": "boolean"}, "include_inactive": {"type": "boolean"},
                  "cursor": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}, "max_bytes": {"type": "integer", "minimum": 256, "maximum": 65536},
                  "alias_scope": {"type": "string", "pattern": "^a[0-9a-f]{8}$", "description": "scope of the view that issued the dN aliases used here; required with any dN"}},
   "required": ["op", "kind"], "additionalProperties": false},
  {"properties": {"op": {"const": "read_evidence"}, "ids": {"type": "array", "items": {"type": "string", "maxLength": 128}, "minItems": 1, "maxItems": 8},
                  "alias_scope": {"type": "string", "pattern": "^a[0-9a-f]{8}$", "description": "scope of the view that issued the dN aliases used here; required with any dN"}},
   "required": ["op", "ids"], "additionalProperties": false},
  {"properties": {"op": {"const": "search_knowledge"}, "query": {"type": "string", "minLength": 1, "maxLength": 400}, "language": {"enum": ["vi", "en"]},
                  "topic": {"type": "string", "description": "topic_id from the KB manifest, or all_authorized"}, "limit": {"type": "integer", "minimum": 1, "maximum": 3}},
   "required": ["op", "query"], "additionalProperties": false},
  {"properties": {"op": {"const": "catalog"}, "detail": {"enum": ["concise", "detail"]}}, "required": ["op"], "additionalProperties": false}
 ]
}
