{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway LM READ Feature metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "feature"
    },
    "feature_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "scope": {
      "enum": [
        "client",
        "gateway"
      ]
    },
    "permission": {
      "enum": [
        "network.read",
        "system.read"
      ]
    },
    "risk": {
      "const": "READ_ONLY"
    },
    "required_ports": {
      "allOf": [
        {
          "$ref": "#/$defs/port_map"
        },
        {
          "minProperties": 1
        }
      ]
    },
    "optional_ports": {
      "$ref": "#/$defs/port_map"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "feature_id",
    "version",
    "name",
    "description",
    "scope",
    "permission",
    "risk",
    "required_ports",
    "optional_ports"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$(?![\\s\\S])",
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "port_map": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/version"
      }
    }
  }
}
